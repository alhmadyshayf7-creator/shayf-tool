#!/usr/bin/env python3
from __future__ import annotations
import os, pty, select, sys, termios, tty, signal
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from lingokey_core import translate, detect_language, strip_ansi, ai_suggest, is_enabled


def _translate_line(line: str) -> str:
    clean = strip_ansi(line).rstrip("\r\n")
    if not clean or detect_language(clean) == "unknown":
        return ""
    if detect_language(clean) != "en":
        return ""
    t = translate(clean, "ar")
    if t == clean:
        return ""
    return t


def main() -> int:
    shell = os.environ.get("SHELL", "/bin/bash")
    pid, fd = pty.fork()
    if pid == 0:
        os.environ["LINGOKEY_TERM"] = "1"
        os.execv(shell, [shell, "-i"])
    old = termios.tcgetattr(sys.stdin)
    tty.setraw(sys.stdin.fileno())
    buffer = b""
    captured = []
    try:
        while True:
            r, _, _ = select.select([sys.stdin, fd], [], [], 0.2)
            if sys.stdin in r:
                data = os.read(sys.stdin.fileno(), 4096)
                if not data: break
                os.write(fd, data)
                captured.append(data.decode(errors="ignore"))
            if fd in r:
                try:
                    data = os.read(fd, 4096)
                except OSError:
                    break
                if not data: break
                os.write(sys.stdout.fileno(), data)
                buffer += data
                while b"\n" in buffer:
                    raw, buffer = buffer.split(b"\n", 1)
                    line = raw.decode(errors="ignore")
                    tr = _translate_line(line)
                    if tr and is_enabled():
                        msg = f"\n\033[90m[LingoKey AR] {tr}\033[0m\n"
                        os.write(sys.stdout.fileno(), msg.encode())
                        captured.append(line)
        if captured and is_enabled():
            text = "\n".join(captured[-80:])
            sugs = ai_suggest(text)
            if sugs:
                os.write(sys.stdout.fileno(), b"\n\033[36m[LingoKey Assistant]\033[0m\n")
                for s in sugs[:3]:
                    msg = f"  {s.command}\n    What: {s.what}\n    Why: {s.why}\n    Impact: {s.impact}\n    Risk: {s.risk}\n"
                    os.write(sys.stdout.fileno(), msg.encode(errors="ignore"))
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)
        try: os.close(fd)
        except OSError: pass
    return 0

if __name__ == "__main__": raise SystemExit(main())
